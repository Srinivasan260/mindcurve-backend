      "isReverseScored": true,
      "options": [
        { "text": "Extremely happy, could not have been more satisfied or pleased", "score": 1 },
        { "text": "Very happy most of the time",                                    "score": 2 },
        { "text": "Generally satisfied, pleased",                                   "score": 3 },
        { "text": "Sometimes fairly satisfied, sometimes fairly unhappy",           "score": 4 },
        { "text": "Generally dissatisfied, unhappy",                                "score": 5 },
        { "text": "Very dissatisfied, unhappy most of the time",                    "score": 6 }
