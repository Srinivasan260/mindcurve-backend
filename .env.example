# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS (comma-separated list of allowed origins; use * to allow all)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=dev

# Frontend URL (used when building magic-login links)
APP_URL=http://localhost:3000

# Magic login token TTL (in minutes)
MAGIC_LINK_TTL_MINUTES=60

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# SMTP (leave SMTP_HOST empty to log magic links to the console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@athma.example.com
MAIL_FROM_NAME=Athma Mind Care

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/MentalHealthInventory"
